// Register map definitions for {{ name }}
//
// This file is auto-generated by embgen. Do not edit manually.
{% macro render_fields(bitfields) %}
      fields: [
{% for bf in bitfields %}
        {
{% if bf.width > 1 %}
          bits: "{{ bf.offset + bf.width - 1 }}:{{ bf.offset }}"
{% elif bf.width == 1 %}
          bits: "{{ bf.offset }}"
{% else %}
          bits: "{{ bf.offset }}:{{ bf.offset + bf.width - 1 }}"
{% endif %}
          name: "{{ bf.name }}"
          desc: "{{ bf.description or '' }}"
{% if bf.reset|int != 0 %}
          resval: {{ bf.reset|int }}
{% endif %}
{% if bf.enums %}
          enum: [
{% for enum in bf.enums %}
            {
              name: "{{ enum.name }}"
              value: {{ enum.value }}
              desc: "{{ enum.description }}"
            }
{% endfor %}
          ]
{% endif %}
        }
{% endfor %}
      ]
{% endmacro %}
{
  name: "{{ name }}"

  clock_primary: "clk_i"
  reset_primary: "rst_ni"
  bus_interfaces: [
    {
      protocol: "reg_iface",
      direction: "device"
    }
  ]
  regwidth: {{ width }}

  registers: [
{% for item in hjson_entries %}
{% if item.kind == "skipto" %}
    { skipto: {{ item.offset }} }
{% elif item.kind == "register" %}
{% set reg = item.entry.reg %}
    {
      name: "{{ reg.name }}"
      desc: "{{ reg.description or 'TODO: Add description' }}"
      swaccess: "{{ reg.access|lower }}"
{% if access_separate %}
      hwaccess: "{{ reg.access_hw|lower }}"
{% endif %}
{% if reg.hwqe %}
      hwqe: {{ reg.hwqe|lower }}
{% endif %}
{% if reg.hwext %}
      hwext: true
{% endif %}
{{ render_fields(reg.bitfields) }}
    }
{% elif item.kind == "multireg" %}
{% set group = item.entry.group %}
    {
      multireg: {
        name: "{{ group.name }}"
        desc: "{{ group.description or '' }}"
        count: "{{ group.count }}"
        cname: "{{ group.cname or group.name }}"
        swaccess: "{{ group.access|lower }}"
  {% if access_separate %}
        hwaccess: "{{ group.access_hw|lower }}"
  {% endif %}
  {% if group.hwqe %}
        hwqe: {{ group.hwqe|lower }}
  {% endif %}
  {% if group.hwext %}
        hwext: true
  {% endif %}
  {% if group.compact is not none %}
        compact: {{ group.compact|lower }}
  {% endif %}
  {% if group.regwen_multi %}
        regwen_multi: true
  {% endif %}
  {{ render_fields(group.bitfields) }}
      }
    }
{% endif %}
{% endfor %}
  ]
}
