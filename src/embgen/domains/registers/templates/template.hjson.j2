// Register map definitions for {{ name }}
// 
// This file is auto-generated by embgen. Do not edit manually.

{
  name: "{{ name }}"
  clock_primary: "clk_i"
  reset_primary: "rst_ni"
  bus_interfaces: [
    {
      protocol: "reg_iface"
      direction: "device"
    }
  ]
  regwidth: {{ width }}
  registers: [
{% for reg in regmap %}
    {
      name: "{{ reg.name }}"
      desc: "{{ reg.description or '' }}"
      swaccess: "{{ reg.access|lower }}"
{% if access_separate %}
      hwaccess: "{{ reg.access_hw|lower }}"
{% endif %}
{% if reg.hwqe %}
      hwqe: {{ reg.hwqe|lower }}
{% endif %}
{% if reg.hwext %}
      hwext: true
{% endif %}
      fields: [
{% for bf in reg.bitfields %}
        {
          bits: "{{ bf.offset + bf.width - 1 }}:{{ bf.offset }}"
          name: "{{ bf.name }}"
          desc: "{{ bf.description or '' }}"
          resval: {{ bf.reset }}
{% if bf.enums %}
          enum: [
{% for enum in bf.enums %}
            {
              name: "{{ enum.name }}"
              value: {{ enum.value }}
              desc: "{{ enum.description }}"
            }
{% endfor %}
          ]
{% endif %}
        }
{% endfor %}
      ]
    }
{% endfor %}
  ]
}

